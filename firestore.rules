rules_version = '2';

// Règles de sécurité Firestore.
// À coller dans : console Firebase → Firestore Database → Règles.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // Codes d'invitation (lisibles par tout utilisateur connecté pour rejoindre).
    match /invites/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.createdBy == request.auth.uid;
    }

    match /groups/{groupId} {
      // --- Pour le document groupe lui-même : on lit resource.data
      //     directement (pas de get() → la requête de liste fonctionne). ---
      function selfBanned(d) {
        return isSignedIn() && ('bannedUids' in d) && d.bannedUids.hasAny([request.auth.uid]);
      }
      function selfMember(d) {
        return isSignedIn() && ('memberUids' in d) && d.memberUids.hasAny([request.auth.uid]);
      }
      function selfAdmin(d) {
        return isSignedIn() && request.auth.uid == d.createdBy;
      }
      // Auto-adhésion : la seule modif est l'ajout de son propre uid à memberUids.
      function isSelfJoin() {
        return isSignedIn() && !selfBanned(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.removeAll(resource.data.memberUids)
               .hasOnly([request.auth.uid]);
      }

      allow read: if isSignedIn() && !selfBanned(resource.data)
                  && (selfMember(resource.data) || selfAdmin(resource.data));
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if selfAdmin(resource.data) || isSelfJoin();
      allow delete: if selfAdmin(resource.data);

      // --- Pour les sous-collections : on doit consulter le groupe parent. ---
      function parent() {
        return get(/databases/$(database)/documents/groups/$(groupId)).data;
      }
      function pBanned() {
        let g = parent();
        return isSignedIn() && ('bannedUids' in g) && g.bannedUids.hasAny([request.auth.uid]);
      }
      function pMember() {
        let g = parent();
        return isSignedIn() && ('memberUids' in g) && g.memberUids.hasAny([request.auth.uid]);
      }
      function pAdmin() { return isSignedIn() && request.auth.uid == parent().createdBy; }
      function pView() { return isSignedIn() && !pBanned() && (pMember() || pAdmin()); }

      match /members/{uid} {
        allow read: if pView();
        allow write: if isSignedIn() && request.auth.uid == uid && !pBanned();
      }

      match /typing/{uid} {
        allow read: if pView();
        allow write: if isSignedIn() && request.auth.uid == uid && !pBanned();
      }

      match /emojis/{name} {
        allow read: if pView();
        allow create: if pView() && request.resource.data.by == request.auth.uid;
        allow delete: if pAdmin() || (pView() && resource.data.by == request.auth.uid);
      }

      match /messages/{messageId} {
        allow read: if pView();
        allow create: if pView()
                      && request.resource.data.author == request.auth.uid
                      // Schéma et tailles bornées : un client ne peut plus
                      // écrire de messages surdimensionnés ou de champs
                      // arbitraires en contournant l'interface.
                      && request.resource.data.keys().hasOnly(
                           ['text', 'image', 'audio', 'author', 'authorName',
                            'authorPhoto', 'ts', 'reactions', 'pinned',
                            'system', 'type', 'question', 'pollOptions', 'pollVotes'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 2000
                      && request.resource.data.image is string
                      && request.resource.data.image.size() <= 900000
                      && (request.resource.data.image.size() == 0
                          || request.resource.data.image.matches(
                               'data:image/(webp|jpeg|png);base64,.*'))
                      && (!('audio' in request.resource.data)
                          || (request.resource.data.audio is string
                              && request.resource.data.audio.size() <= 900000
                              && (request.resource.data.audio.size() == 0
                                  || request.resource.data.audio.matches(
                                       'data:audio/[a-z0-9.+]+;base64,.*'))))
                      && request.resource.data.reactions is map
                      && request.resource.data.reactions.size() == 0
                      && request.resource.data.pinned == false
                      && (!('pollVotes' in request.resource.data)
                          || (request.resource.data.pollVotes is map
                              && request.resource.data.pollVotes.size() == 0))
                      && (!('pollOptions' in request.resource.data)
                          || (request.resource.data.pollOptions is list
                              && request.resource.data.pollOptions.size() <= 10))
                      && (!('question' in request.resource.data)
                          || (request.resource.data.question is string
                              && request.resource.data.question.size() <= 200));
        allow update: if pView() && (
          // Réactions et votes : maps entières interdites, seuls les updates
          // ciblés via FieldValue (voir store.js) passent, avec tailles bornées.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
           && request.resource.data.reactions is map
           && request.resource.data.reactions.size() <= 50)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pollVotes'])
           && request.resource.data.pollVotes is map
           && request.resource.data.pollVotes.size() <= 50)
          || pAdmin()
        );
        allow delete: if pAdmin()
                      || (pView() && resource.data.author == request.auth.uid);
      }
    }
  }
}
