rules_version = '2';

// Règles de sécurité Firestore.
// À coller dans : console Firebase → Firestore Database → Règles.
service cloud.firestore {
  match /databases/{database}/documents {

    // Codes d'invitation (lisibles par tout utilisateur connecté pour rejoindre).
    match /invites/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;
    }

    match /groups/{groupId} {
      function groupData() {
        return get(/databases/$(database)/documents/groups/$(groupId)).data;
      }
      function bannedUids() {
        let g = groupData();
        return ('bannedUids' in g) ? g.bannedUids : [];
      }
      function memberUids() {
        let g = groupData();
        return ('memberUids' in g) ? g.memberUids : [];
      }
      function isSignedIn() { return request.auth != null; }
      function isBanned() { return isSignedIn() && bannedUids().hasAny([request.auth.uid]); }
      function isAdmin() { return isSignedIn() && request.auth.uid == groupData().createdBy; }
      function isMember() { return isSignedIn() && memberUids().hasAny([request.auth.uid]); }
      // Accès réservé aux membres (créateur ou personnes ayant rejoint par code).
      function canView() {
        return isSignedIn() && !isBanned() && (isMember() || isAdmin());
      }
      // Auto-adhésion : la seule modif est l'ajout de son propre uid à memberUids.
      function isSelfJoin() {
        return isSignedIn() && !isBanned()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.removeAll(resource.data.memberUids)
               .hasOnly([request.auth.uid]);
      }

      allow read: if canView();
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() || isSelfJoin();
      allow delete: if isAdmin();

      match /members/{uid} {
        allow read: if canView();
        allow write: if isSignedIn() && request.auth.uid == uid && !isBanned();
      }

      match /messages/{messageId} {
        allow read: if canView();
        allow create: if canView()
                      && request.resource.data.author == request.auth.uid;
        allow update: if canView() && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          || isAdmin()
        );
        allow delete: if isAdmin();
      }
    }
  }
}
