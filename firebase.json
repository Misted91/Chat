{
  "hosting": {
    "public": ".",
    "headers": [
      {
        "source": "**/*.@(html|css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".github/**",
      "**/.*",
      "**/node_modules/**",
      "firestore.rules",
      "README.md"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
